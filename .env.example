# Copie para .env e preencha. O arquivo .env não é versionado.

# --- LLM ---------------------------------------------------------------------
# Guia completo: docs/LLM_PROVIDERS.md
# Opções:
# anthropic | openai | groq | google_genai | openrouter | ollama
LLM_PROVIDER=groq

# Modelo padrão para testes gratuitos. Precisa estar em finance_copilot/llm/models.toml
# quando LLM_FREE_ONLY=true. Exemplos gratuitos/locais:
#   groq:         openai/gpt-oss-120b | openai/gpt-oss-20b
#   google_genai: gemini-3.5-flash-lite | gemini-3.6-flash
#   openrouter:   openrouter/free | <id-terminado-em>:free
#   ollama:       qwen3:8b | llama3.1:8b | gpt-oss:20b
LLM_MODEL=openai/gpt-oss-120b

# true (recomendado): só aceita modelos marcados como free/local no catálogo. Modelos pagos ou
# de custo desconhecido são bloqueados, e nunca há troca automática de modelo ou provedor.
# false: libera modelos pagos (Anthropic, OpenAI...), que consomem créditos.
LLM_FREE_ONLY=true

# Opcional. Deixe vazio para usar o padrão do modelo: alguns modelos recusam este parâmetro.
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=60

# Credenciais individuais: preencha só a do provedor que usar. Cada chave vale apenas para o
# próprio provedor (nunca coloque a chave do OpenRouter ou do Groq em OPENAI_API_KEY).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama (local, sem chave). Baixe o modelo antes: ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Opcional: catálogo de modelos alternativo (padrão: finance_copilot/llm/models.toml).
LLM_CATALOG_PATH=

# --- LangSmith (opcional) ----------------------------------------------------
# O tracing só é ativado com LANGSMITH_TRACING=true E uma chave preenchida.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finance-copilot

# --- Armazenamento -----------------------------------------------------------
FINANCE_DB_PATH=data/finance.db
AGENT_STATE_DB_PATH=data/agent_state.db
