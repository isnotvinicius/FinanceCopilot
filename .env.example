# Copie para .env e preencha. O arquivo .env não é versionado.

# --- LLM ---------------------------------------------------------------------
# Provedor aceito por init_chat_model: anthropic | openai
LLM_PROVIDER=anthropic
# Nome do modelo no provedor escolhido. Precisa suportar tool calling.
LLM_MODEL=claude-sonnet-5-5
# Opcional. Deixe vazio para usar o padrão do modelo: alguns modelos recusam este parâmetro.
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=60

# Preencha apenas a chave do provedor escolhido.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LangSmith (opcional) ----------------------------------------------------
# O tracing só é ativado com LANGSMITH_TRACING=true E uma chave preenchida.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finance-copilot

# --- Armazenamento -----------------------------------------------------------
FINANCE_DB_PATH=data/finance.db
AGENT_STATE_DB_PATH=data/agent_state.db
